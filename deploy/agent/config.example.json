{
  "server": "wss://panel.example.com/agent/ws",
  "name": "",
  "enroll_token": "PASTE_A_ONE_TIME_TOKEN_FROM_THE_WEB_CONSOLE",
  "state_file": "state.json",
  "heartbeat_interval": "10s",
  "reconnect_min": "1s",
  "reconnect_max": "30s",
  "dial_timeout": "15s",
  "handshake_timeout": "15s",
  "write_timeout": "10s",
  "command_timeout": "30s",
  "max_command_output_bytes": 524288,
  "shell": "/bin/bash",
  "exec_enabled": true,
  "terminal_enabled": true,
  "file_browser_enabled": false,
  "file_browser_root": "/",
  "file_transfer_chunk_bytes": 65536,
  "max_file_transfer_bytes": 1073741824,
  "disk_exclude_device_prefixes": [
    "/dev/loop",
    "/dev/zram",
    "/dev/ram"
  ],
  "cloudflare_access": {
    "client_id": "",
    "client_secret": ""
  },
  "tls": {
    "insecure_skip_verify": false
  }
}
