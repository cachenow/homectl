{
  "listen_addr": "127.0.0.1:8080",
  "database_path": "data/homectl.db",
  "legacy_device_store": "",
  "admin_username": "admin",
  "admin_password": "CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD",
  "cookie_secure": false,
  "session_ttl": "24h",
